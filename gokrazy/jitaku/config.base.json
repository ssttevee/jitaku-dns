{
    "Hostname": "jitaku",
    "Update": {
        "HTTPPort": "8080",
        "HTTPPassword": "",
        "NoPassword": true
    },
    "Environment": [
        "GOOS=linux"
    ],
    "Packages": [
        "github.com/gokrazy/fbstatus",
        "github.com/gokrazy/mkfs",
        "github.com/ssttevee/jitaku-dns"
    ],
    "PackageConfig": {
        "github.com/ssttevee/jitaku-dns": {
            "CommandLineFlags": [
                "-webui",
                "-webui-port=80",
                "-webui-host=0.0.0.0"
            ],
            "WaitForClock": true
        }
    },
    "SerialConsole": "disabled"
}
